{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": { "productName": "LocalCoder", "version": "0.1.0" },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": { "all": true, "scope": ["$HOME/**", "$DOCUMENT/**", "/home/**", "/root/**", "/var/**"] },
      "path": { "all": true },
      "dialog": { "all": true },
      "shell": { "all": false }
    },
    "windows": [{
      "fullscreen": false, "resizable": true, "title": "LocalCoder",
      "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600
    }],
    "security": { "csp": null },
    "bundle": {
      "active": true, "targets": "all",
      "identifier": "com.localcoder.app", "icon": [],
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
